// 8. GESTIÓN DE PROMEDIOS Y ENVÍO A BD (1.5 MIN)
// ==========================================
void resetAccumulators() {
  sumBodyTemp = 0.0;
  sumAmbientTemp = 0.0;
  sumHumidity = 0.0;
  envSamples = 0;

  sumBpm = 0;
  bpmSamples = 0;

  sumSpo2 = 0;
  spo2Samples = 0;
}

void registrarEventoBD(int idSensorOrigen, float valorAlarma, int severidad, const char* motivo, bool esAlarma) {
  if (ciclosGuardados >= MAX_CICLOS_MEMORIA) {
    limpiarColaMemoria();
  }

  String fechaMexico = obtenerFechaHoraMexico();

  if (esAlarma) {
    Serial.println("\n================ 🚨 ALARMA DETECTADA ================");
    enviarMedicionJSON(idSensorOrigen, fechaMexico, valorAlarma);
    enviarAlarmaJSON(idSensorOrigen, fechaMexico, severidad, motivo);
    Serial.println("=====================================================\n");

    actualizarPantalla();
  } else {
    float outBodyTemp = (envSamples > 0) ? (sumBodyTemp / envSamples) : bodyTemp;

    int outBpm = -1;
    if (bpmSamples > 0) {
      outBpm = sumBpm / bpmSamples;
    } else if (fingerDetected && validHeartRate && heartRate >= 30 && heartRate < 180) {
      outBpm = heartRate;
    }

    int outSpo2 = -1;
    if (spo2Samples > 0) {
      outSpo2 = sumSpo2 / spo2Samples;
    } else if (fingerDetected && validSPO2 && spo2 > 70 && spo2 <= 100) {
      outSpo2 = spo2;
    }

    Serial.println("\n---------------- 📡 ENVÍO PERIÓDICO BD (1.5 MIN) ----------------");
    enviarMedicionJSON(ID_SENSOR_TMP, fechaMexico, outBodyTemp);

    if (outBpm != -1) {
      enviarMedicionJSON(ID_SENSOR_BPM, fechaMexico, (float)outBpm);
    }

    if (outSpo2 != -1) {
      enviarMedicionJSON(ID_SENSOR_SPO2, fechaMexico, (float)outSpo2);
    }

    enviarMedicionJSON(ID_SENSOR_MPU, fechaMexico, (float)stepCount);
    Serial.println("-----------------------------------------------------------------\n");

    ciclosGuardados++;
    resetAccumulators();
    lastDbSendTime = millis();
  }
}

// ==========================================
// 9. FUNCIONES DE AHORRO DE ENERGÍA
// ==========================================
void enterLowPowerMode() {
  if (lowPowerMode) return;
  lowPowerMode = true;

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x40);
  Wire.endTransmission();

  particleSensor.shutDown();
  tmp117.setMeasurementMode(TMP117_MODE_SHUTDOWN);

  // Mostrar aviso breve en OLED antes de apagarla para confirmar que enciende
  u8g2.clearBuffer();
  u8g2.setDrawColor(1);
  u8g2.setCursor(10, 20);
  u8g2.print("Modo ahorro activo");
  u8g2.setCursor(10, 36);
  u8g2.print("Humedad: ");
  u8g2.print(ambientHumidity, 0);
  u8g2.print("% (<55%)");
  u8g2.sendBuffer();
  delay(1500);

  u8g2.setPowerSave(1);

  currentFallState = NORMAL;
  fallAlertActive = false;
  lowBpmAlert = false;
  lowSpo2Alert = false;
  lowBpmStreak = 0;
  lowSpo2Streak = 0;
  currentTempState = TEMP_NORMAL_STATE;
  prevTempState = TEMP_NORMAL_STATE;
  resetAccumulators();

  Serial.println("\n💤 HUMEDAD < 55%: Modo ahorro activado. Solo SHT40 activo...\n");
}

void exitLowPowerMode() {
  if (!lowPowerMode) return;
  lowPowerMode = false;

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission();

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x1B);
  Wire.write(0x08);
  Wire.endTransmission();

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x1C);
  Wire.write(0x10);
  Wire.endTransmission();

  particleSensor.wakeUp();
  samplesInBuffer = 0;
  newSampleCount = 0;

  tmp117.setMeasurementMode(TMP117_MODE_CONTINUOUS);
  sensors_event_t temp_tmp;
  if (tmp117.getEvent(&temp_tmp)) {
    bodyTemp = temp_tmp.temperature + TEMP_OFFSET;
  }

  u8g2.setPowerSave(0);
  actualizarPantalla();

  resetAccumulators();
  unsigned long now = millis();
  lastMpuSample = now;
  lastSlowPoll = now;
  lastDbSendTime = now;

  Serial.println("\n⚡ HUMEDAD >= 55%: Sensores reactivados.\n");
}

