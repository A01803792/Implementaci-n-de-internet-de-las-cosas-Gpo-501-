void mostrarVistaAlerta() {
  u8g2.clearBuffer();
  u8g2.setDrawColor(1);

  dibujarSimboloAlerta();
  u8g2.drawLine(46, 0, 46, 63);

  u8g2.drawBox(49, 0, 79, 11);
  u8g2.setDrawColor(0);
  u8g2.setCursor(64, 2);
  u8g2.print("ALERTA!");
  u8g2.setDrawColor(1);

  int yPos = 18;

  if (fallAlertActive && yPos <= 50) {
    u8g2.setCursor(50, yPos);
    u8g2.print("CAIDA!");
    yPos += 16;
  }

  if (lowBpmAlert && yPos <= 50) {
    u8g2.setCursor(50, yPos);
    u8g2.print("PULSO:");
    u8g2.print(heartRate);
    yPos += 16;
  }

  if (lowSpo2Alert && yPos <= 50) {
    u8g2.setCursor(50, yPos);
    u8g2.print("SPO2:");
    u8g2.print(spo2);
    u8g2.print("%");
    yPos += 16;
  }

  if (currentTempState != TEMP_NORMAL_STATE && yPos <= 50) {
    u8g2.setCursor(50, yPos);
    switch (currentTempState) {
      case TEMP_HIPOTERMIA_STATE: u8g2.print("HIPOTERMIA"); break;
      case TEMP_VIGILANCIA_STATE: u8g2.print("VIGILANCIA"); break;
      case TEMP_FIEBRE_STATE:     u8g2.print("FIEBRE!");    break;
      case TEMP_EMERGENCIA_STATE: u8g2.print("EMERGENCIA"); break;
      default: break;
    }
    yPos += 16;

    if (yPos <= 50) {
      u8g2.setCursor(50, yPos);
      u8g2.print("TMP:");
      u8g2.print(bodyTemp, 1);
      u8g2.print("C");
    }
  }

  u8g2.sendBuffer();
}

void actualizarPantalla() {
  if (lowPowerMode) return;

  bool hayAlerta = fallAlertActive || lowBpmAlert || lowSpo2Alert || (currentTempState != TEMP_NORMAL_STATE);
  if (hayAlerta) {
    mostrarVistaAlerta();
  } else {
    mostrarVistaNormal();
  }
}

