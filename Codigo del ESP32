String obtenerFechaHoraMexico() {
  struct tm timeinfo;
  if (getLocalTime(&timeinfo, 50)) {
    char bufferFecha[25];
    strftime(bufferFecha, sizeof(bufferFecha), "%Y-%m-%d %H:%M:%S", &timeinfo);
    return String(bufferFecha);
  }

  unsigned long totalSeg = millis() / 1000;
  unsigned int seg  = totalSeg % 60;
  unsigned int min  = (39 + (totalSeg / 60)) % 60;
  unsigned int hora = (12 + ((39 + (totalSeg / 60)) / 60)) % 24;
  char buf[25];
  snprintf(buf, sizeof(buf), "2026-11-23 %02u:%02u:%02u", hora, min, seg);
  return String(buf);
}

String obtenerHoraCortaMexico() {
  struct tm timeinfo;
  if (getLocalTime(&timeinfo, 20)) {
    char bufferHora[10];
    strftime(bufferHora, sizeof(bufferHora), "%H:%M", &timeinfo);
    return String(bufferHora);
  }
  return "--:--";
}

// --- ENVÍO EN VIVO CADA 1 SEGUNDO (SIN GUARDAR EN MEMORIA DEL ESP) ---
void enviarDatosLive() {
  if (lowPowerMode) return;
  if (WiFi.status() != WL_CONNECTED || !client.connected()) return;

  int liveBpm  = (fingerDetected && validHeartRate && heartRate >= 30 && heartRate < 180) ? heartRate : 0;
  int liveSpo2 = (fingerDetected && validSPO2 && spo2 > 70 && spo2 <= 100) ? spo2 : 0;

  char bufTemp[12];
  char bufSteps[16];
  snprintf(bufTemp,  sizeof(bufTemp),  "%.1f", bodyTemp);
  snprintf(bufSteps, sizeof(bufSteps), "%lu",  stepCount);

  // Temperatura y pasos se envían cada segundo
  client.publish(TOPIC_LIVE_TEMP,  bufTemp,  false);
  client.publish(TOPIC_LIVE_STEPS, bufSteps, false);

  // BPM y SpO2 solo se envían si son mayores a 0
  if (liveBpm > 0) {
    char bufBpm[12];
    snprintf(bufBpm, sizeof(bufBpm), "%d", liveBpm);
    client.publish(TOPIC_LIVE_BPM, bufBpm, false);
  }

  if (liveSpo2 > 0) {
    char bufSpo2[12];
    snprintf(bufSpo2, sizeof(bufSpo2), "%d", liveSpo2);
    client.publish(TOPIC_LIVE_SPO2, bufSpo2, false);
  }

  client.loop();

  Serial.print("⚡ [LIVE] Temp: "); Serial.print(bufTemp);
  Serial.print(" | BPM: ");        Serial.print(liveBpm > 0 ? String(liveBpm) : "--");
  Serial.print(" | SpO2: ");       Serial.print(liveSpo2 > 0 ? String(liveSpo2) : "--");
  Serial.print(" | Pasos: ");      Serial.println(bufSteps);
}

void limpiarColaMemoria() {
  for (uint8_t i = 0; i < MAX_COLA_JSON; i++) {
    colaJson[i].payload = "";
    colaJson[i].idSensor = 0;
    colaJson[i].esAlarma = false;
  }
  totalEnCola = 0;
  ciclosGuardados = 0;
}

bool existeEnCola(const String& payload) {
  for (uint8_t i = 0; i < totalEnCola; i++) {
    if (colaJson[i].payload == payload) {
      return true;
    }
  }
  return false;
}

void despacharJsonMQTT(bool esAlarma, int idSensor, const String& payload) {
  const char* destino = esAlarma ? TOPIC_ALARMA : TOPIC_MEDICION;

  if (esAlarma) {
    if (payload == ultimaAlarmaEnviada) {
      Serial.println("⏭ [MQTT BD] Alarma duplicada omitida.");
      return;
    }
  } else if (idSensor >= 1 && idSensor <= 4) {
    if (payload == ultimoPayloadMedicion[idSensor]) {
      Serial.print("⏭ [MQTT BD] Medición duplicada omitida para sensor ");
      Serial.println(idSensor);
      return;
    }
  }

  if (WiFi.status() == WL_CONNECTED && client.connected()) {
    Serial.print("📤 [MQTT BD -> ");
    Serial.print(destino);
    Serial.print("] ");
    Serial.print(payload);

    bool ok = client.publish(destino, payload.c_str(), false);
    client.loop();

    if (ok) {
      Serial.println("  --> ✔ ENVIADO OK");
      if (esAlarma) {
        ultimaAlarmaEnviada = payload;
      } else if (idSensor >= 1 && idSensor <= 4) {
        ultimoPayloadMedicion[idSensor] = payload;
      }
    } else {
      Serial.print("  --> ❌ ERROR AL PUBLICAR (rc=");
      Serial.print(client.state());
      Serial.println(")");
    }
    return;
  }

  if (!existeEnCola(payload) && totalEnCola < MAX_COLA_JSON) {
    colaJson[totalEnCola].esAlarma = esAlarma;
    colaJson[totalEnCola].idSensor = idSensor;
    colaJson[totalEnCola].payload  = payload;
    totalEnCola++;

    Serial.print("💾 [SIN RED - EN COLA #");
    Serial.print(totalEnCola);
    Serial.print(" -> ");
    Serial.print(destino);
    Serial.print("] ");
    Serial.println(payload);
  }
}

void vaciarColaPendiente() {
  if (totalEnCola == 0 || !client.connected()) return;

  Serial.print("🔄 Enviando ");
  Serial.print(totalEnCola);
  Serial.println(" mensajes BD pendientes en cola...");

  for (uint8_t i = 0; i < totalEnCola; i++) {
    const char* destino = colaJson[i].esAlarma ? TOPIC_ALARMA : TOPIC_MEDICION;
    Serial.print("   📤 [COLA -> ");
    Serial.print(destino);
    Serial.print("] ");
    Serial.print(colaJson[i].payload);

    if (client.publish(destino, colaJson[i].payload.c_str(), false)) {
      Serial.println("  --> ✔ ENVIADO OK");
      if (colaJson[i].esAlarma) {
        ultimaAlarmaEnviada = colaJson[i].payload;
      } else if (colaJson[i].idSensor >= 1 && colaJson[i].idSensor <= 4) {
        ultimoPayloadMedicion[colaJson[i].idSensor] = colaJson[i].payload;
      }
    } else {
      Serial.println("  --> ❌ FALLÓ");
    }
    client.loop();
  }
  limpiarColaMemoria();
}

void mantenerConexionMQTT(unsigned long now) {
  if (WiFi.status() != WL_CONNECTED) return;

  if (!client.connected()) {
    if (now - lastMqttReconnect >= 5000) {
      lastMqttReconnect = now;
      String clientId = "ESP32C3_VitaLink_" + String((uint32_t)ESP.getEfuseMac(), HEX);
      Serial.print("🔌 Conectando a servidor MQTT (");
      Serial.print(mqtt_server);
      Serial.print(")...");

      if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
        Serial.println(" ✔ CONECTADO!");
        vaciarColaPendiente();
      } else {
        Serial.print(" ❌ Falló (rc=");
        Serial.print(client.state());
        Serial.println("), reintentando en 5s.");
      }
    }
  } else {
    client.loop();
  }
}

void enviarMedicionJSON(int idSensor, const String& fechaStr, float valor) {
  String json = "{";
  json += "\"sensor\":" + String(idSensor) + ",";
  json += "\"fecha\":\"" + fechaStr + "\",";
  json += "\"valor\":" + String(valor, 2);
  json += "}";

  despacharJsonMQTT(false, idSensor, json);
}

void enviarAlarmaJSON(int idSensor, const String& fechaStr, int severidad, const char* descripcion) {
  String json = "{";
  json += "\"sensor\":" + String(idSensor) + ",";
  json += "\"fecha\":\"" + fechaStr + "\",";
  json += "\"severidad\":" + String(severidad) + ",";
  json += "\"descripcion\":\"" + String(descripcion) + "\"";
  json += "}";

  despacharJsonMQTT(true, idSensor, json);
}

