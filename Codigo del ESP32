void actualizarMPU(unsigned long now) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 14, true);

  if (Wire.available() == 14) {
    int16_t rawAcX = (Wire.read() << 8) | Wire.read();
    int16_t rawAcY = (Wire.read() << 8) | Wire.read();
    int16_t rawAcZ = (Wire.read() << 8) | Wire.read();
    Wire.read(); Wire.read();
    int16_t rawGyX = (Wire.read() << 8) | Wire.read();
    int16_t rawGyY = (Wire.read() << 8) | Wire.read();
    int16_t rawGyZ = (Wire.read() << 8) | Wire.read();

    float ax = rawAcX / 4096.0;
    float ay = rawAcY / 4096.0;
    float az = rawAcZ / 4096.0;
    float gx = rawGyX / 65.5;
    float gy = rawGyY / 65.5;
    float gz = rawGyZ / 65.5;

    float totalG = sqrt(ax * ax + ay * ay + az * az);
    float gyroMag = sqrt(gx * gx + gy * gy + gz * gz);

    // Conteo acumulativo de pasos
    if (totalG > 1.30 && !stepFlag && (now - lastStepTime > 320)) {
      stepCount++;
      stepFlag = true;
      lastStepTime = now;
    } else if (totalG < 1.10) {
      stepFlag = false;
    }

    // Detección de caídas -> ID 4 (MPU6050), Severidad 2
    switch (currentFallState) {
      case NORMAL:
        if (totalG < 0.45) {
          currentFallState = FREE_FALL;
          fallStateTimestamp = now;
        }
        break;

      case FREE_FALL:
        if (totalG > 2.4) {
          currentFallState = IMPACT_DETECTED;
          fallStateTimestamp = now;
        } else if (now - fallStateTimestamp > 600) {
          currentFallState = NORMAL;
        }
        break;

      case IMPACT_DETECTED:
        if (now - fallStateTimestamp >= 1500) {
          bool munecaQuieta = (gyroMag < 35.0) && (abs(totalG - 1.0) < 0.20);
          if (munecaQuieta && !fallAlertActive) {
            fallAlertActive = true;
            fallCount++;
            registrarEventoBD(ID_SENSOR_MPU, totalG, SEV_CAIDA, "Caida detectada en muneca", true);
          }
          currentFallState = NORMAL;
        }
        break;
    }

    if (fallAlertActive && gyroMag > 90.0) {
      fallAlertActive = false;
    }
  }
}

void evaluarAlertasOximetro() {
  fingerDetected = (irBuffer[BUFFER_SIZE - 1] >= 50000);

  if (!fingerDetected) {
    lowBpmAlert = false;
    lowSpo2Alert = false;
    lowBpmStreak = 0;
    lowSpo2Streak = 0;
    return;
  }

  // Evaluar latidos bajos -> ID 2 (BPM), Severidad 4
  if (validHeartRate && heartRate >= 30 && heartRate < 180) {
    if (heartRate < BPM_MIN_ALERTA) {
      if (lowBpmStreak < 3) lowBpmStreak++;
      if (lowBpmStreak >= 3 && !lowBpmAlert) {
        lowBpmAlert = true;
        registrarEventoBD(ID_SENSOR_BPM, (float)heartRate, SEV_PULSO_BAJO, "Ritmo cardiaco bajo (< 50 BPM)", true);
      }
    } else {
      lowBpmStreak = 0;
      lowBpmAlert = false;
    }
  }

  // Evaluar SpO2 < 90% -> ID 3 (SpO2), Severidad 5
  if (validSPO2 && spo2 > 70 && spo2 <= 100) {
    if (spo2 < SPO2_MIN_ALERTA) {
      if (lowSpo2Streak < 3) lowSpo2Streak++;
      if (lowSpo2Streak >= 3 && !lowSpo2Alert) {
        lowSpo2Alert = true;
        registrarEventoBD(ID_SENSOR_SPO2, (float)spo2, SEV_OXIGENO_BAJO, "Oxigenacion deficiente (< 90%)", true);
      }
    } else {
      lowSpo2Streak = 0;
      lowSpo2Alert = false;
    }
  }
}

void actualizarMAX30102() {
  particleSensor.check();
  while (particleSensor.available()) {
    uint32_t red = particleSensor.getRed();
    uint32_t ir = particleSensor.getIR();
    particleSensor.nextSample();

    if (samplesInBuffer < BUFFER_SIZE) {
      redBuffer[samplesInBuffer] = red;
      irBuffer[samplesInBuffer] = ir;
      samplesInBuffer++;

      if (samplesInBuffer == BUFFER_SIZE) {
        maxim_heart_rate_and_oxygen_saturation(irBuffer, BUFFER_SIZE, redBuffer, &spo2, &validSPO2, &heartRate, &validHeartRate);
        evaluarAlertasOximetro();
      }
    } else {
      newRed[newSampleCount] = red;
      newIR[newSampleCount] = ir;
      newSampleCount++;

      if (newSampleCount == 25) {
        for (byte i = 25; i < BUFFER_SIZE; i++) {
          redBuffer[i - 25] = redBuffer[i];
          irBuffer[i - 25] = irBuffer[i];
        }
        for (byte i = 0; i < 25; i++) {
          redBuffer[75 + i] = newRed[i];
          irBuffer[75 + i] = newIR[i];
        }
        newSampleCount = 0;

        maxim_heart_rate_and_oxygen_saturation(irBuffer, BUFFER_SIZE, redBuffer, &spo2, &validSPO2, &heartRate, &validHeartRate);
        evaluarAlertasOximetro();
      }
    }
  }
}

void evaluarTemperaturaCorporal() {
  sensors_event_t temp_tmp;
  if (!tmp117.getEvent(&temp_tmp)) return;

  bodyTemp = temp_tmp.temperature + TEMP_OFFSET;

  TempStatus nextState = currentTempState;

  if (bodyTemp < TEMP_HIPOTERMIA) {
    nextState = TEMP_HIPOTERMIA_STATE;
  } else if (bodyTemp > TEMP_EMERGENCIA) {
    nextState = TEMP_EMERGENCIA_STATE;
  } else if (bodyTemp >= TEMP_FIEBRE) {
    nextState = TEMP_FIEBRE_STATE;
  } else if (bodyTemp >= TEMP_VIGILANCIA) {
    if (currentTempState == TEMP_FIEBRE_STATE && bodyTemp >= (TEMP_FIEBRE - TEMP_HISTERESIS)) {
      nextState = TEMP_FIEBRE_STATE;
    } else {
      nextState = TEMP_VIGILANCIA_STATE;
    }
  } else {
    if (currentTempState == TEMP_HIPOTERMIA_STATE && bodyTemp < (TEMP_HIPOTERMIA + TEMP_HISTERESIS)) {
      nextState = TEMP_HIPOTERMIA_STATE;
    } else if (currentTempState == TEMP_VIGILANCIA_STATE && bodyTemp >= (TEMP_VIGILANCIA - TEMP_HISTERESIS)) {
      nextState = TEMP_VIGILANCIA_STATE;
    } else {
      nextState = TEMP_NORMAL_STATE;
    }
  }

  currentTempState = nextState;

  if (currentTempState != prevTempState) {
    prevTempState = currentTempState;
    switch (currentTempState) {
      case TEMP_HIPOTERMIA_STATE:
        registrarEventoBD(ID_SENSOR_TMP, bodyTemp, SEV_HIPOTERMIA, "Hipotermia detectada (< 30.5 C)", true);
        break;
      case TEMP_VIGILANCIA_STATE:
        registrarEventoBD(ID_SENSOR_TMP, bodyTemp, SEV_VIGILANCIA, "Vigilancia termica (34.8 - 35.1 C)", true);
        break;
      case TEMP_FIEBRE_STATE:
        registrarEventoBD(ID_SENSOR_TMP, bodyTemp, SEV_FIEBRE, "Fiebre detectada (>= 35.2 C)", true);
        break;
      case TEMP_EMERGENCIA_STATE:
        registrarEventoBD(ID_SENSOR_TMP, bodyTemp, SEV_FIEBRE_CRITICA, "Fiebre critica (> 37.2 C)", true);
        break;
      case TEMP_NORMAL_STATE:
        break;
    }
  }
}

// ==========================================
// 11. SETUP Y LOOP PRINCIPAL
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n=== INICIANDO SISTEMA VITALINK ===");

  // 1. Inicializar Bus I2C Hardware (Pines 4 y 5) para sensores
  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(100000);

  // 2. Inicializar Sensores
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  if (Wire.endTransmission() == 0) {
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(0x1B); Wire.write(0x08);
    Wire.endTransmission();
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(0x1C); Wire.write(0x10);
    Wire.endTransmission();
    Serial.println("✔ MPU6050: Listo");
  }

  if (tmp117.begin()) {
    Serial.println("✔ TMP117: Listo");
    sensors_event_t temp_tmp;
    if (tmp117.getEvent(&temp_tmp)) bodyTemp = temp_tmp.temperature + TEMP_OFFSET;
  }

  if (sht40.begin()) {
    sht40.setPrecision(SHT4X_HIGH_PRECISION);
    sht40.setHeater(SHT4X_NO_HEATER);
    Serial.println("✔ SHT40: Listo");
  }

  if (particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    particleSensor.setup(60, 4, 2, 100, 411, 4096);
    particleSensor.setPulseAmplitudeRed(0x1F);
    particleSensor.setPulseAmplitudeIR(0x1F);
    Serial.println("✔ MAX30102: Listo");
  }

  // 3. Conectar Wi-Fi y sincronizar hora oficial de México (UTC-6)
  Serial.print("Conectando a WiFi...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  WiFi.setTxPower(WIFI_POWER_15dBm);

  unsigned long inicioWifi = millis();
  while (WiFi.status() != WL_CONNECTED && (millis() - inicioWifi < 10000)) {
    delay(500);
    Serial.print(".");
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n✔ WiFi conectado.");
    configTime(GMT_OFFSET_MEXICO_SEC, DAYLIGHT_OFFSET_SEC, "pool.ntp.org", "time.nist.gov");
    time_t now = time(nullptr);
    unsigned long inicioNtp = millis();
    while (now < 1600000000 && (millis() - inicioNtp < 8000)) {
      delay(500);
      now = time(nullptr);
    }
    Serial.print("✔ Hora México sincronizada: ");
    Serial.println(obtenerFechaHoraMexico());
  } else {
    Serial.println("\n⚠ Sin WiFi inicial: operando en modo local.");
  }

  // 4. Inicializar Pantalla OLED DESPUÉS del Wi-Fi para evitar reinicio por pico de voltaje
  u8g2.setBusClock(100000);
  u8g2.begin();
  u8g2.setPowerSave(0);
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.setFontPosTop();
  Serial.println("✔ Pantalla OLED: Lista en GPIO 0 y 1");

  client.setServer(mqtt_server, mqtt_port);
  client.setBufferSize(512);

  lastDbSendTime = millis();
  mostrarVistaNormal();

  // Verificar humedad inicial
  sensors_event_t humidity, temp_sht;
  if (sht40.getEvent(&humidity, &temp_sht)) {
    ambientHumidity = humidity.relative_humidity;
    ambientTemp = temp_sht.temperature;
    if (ambientHumidity < HUMEDAD_ACTIVACION) {
      enterLowPowerMode();
    }
  }
}

void loop() {
  unsigned long now = millis();

  // Mantener enlace MQTT activo sin bloquear sensores
  mantenerConexionMQTT(now);

  // --- MODO AHORRO DE ENERGÍA ---
  if (lowPowerMode) {
    if (now - lastSleepCheck >= 2000) {
      lastSleepCheck = now;

      sensors_event_t humidity, temp_sht;
      if (sht40.getEvent(&humidity, &temp_sht)) {
        ambientHumidity = humidity.relative_humidity;
        ambientTemp = temp_sht.temperature;

        if (ambientHumidity >= HUMEDAD_ACTIVACION) {
          exitLowPowerMode();
        }
      }
    }
    return;
  }

  // --- MODO ACTIVO COMPLETO ---
  // 1. Muestreo rápido MPU6050 (50 Hz)
  if (now - lastMpuSample >= 20) {
    lastMpuSample = now;
    actualizarMPU(now);
  }

  // 2. Muestreo continuo MAX30102
  actualizarMAX30102();

  // 3. Muestreo interno, refresco OLED y envío LIVE cada 1 segundo
  if (now - lastSlowPoll >= 1000) {
    lastSlowPoll = now;

    sensors_event_t humidity, temp_sht;
    if (sht40.getEvent(&humidity, &temp_sht)) {
      ambientHumidity = humidity.relative_humidity;
      ambientTemp = temp_sht.temperature;

      if (ambientHumidity < HUMEDAD_ACTIVACION) {
        enterLowPowerMode();
        return;
      }
    }

    evaluarTemperaturaCorporal();

    // Acumular muestras ambientales y corporales del ciclo BD
    sumBodyTemp += bodyTemp;
    sumAmbientTemp += ambientTemp;
    sumHumidity += ambientHumidity;
    envSamples++;

    // Acumular muestras cardíacas del ciclo BD
    if (fingerDetected) {
      if (validHeartRate && heartRate >= 30 && heartRate < 180) {
        sumBpm += heartRate;
        bpmSamples++;
      }
      if (validSPO2 && spo2 > 70 && spo2 <= 100) {
        sumSpo2 += spo2;
        spo2Samples++;
      }
    }

    // Enviar datos crudos en vivo al servidor (BPM y SpO2 solo si > 0)
    enviarDatosLive();

    // Actualizar pantalla OLED
    actualizarPantalla();
  }

  // 4. Envío periódico BD cada 1.5 minutos a vitalink/recv
  if (now - lastDbSendTime >= DB_SEND_INTERVAL) {
    registrarEventoBD(0, 0.0, 0, "CICLO COMPLETADO", false);
  }
}
