void dibujarCaritaFeliz(int cx, int cy, int r) {
  u8g2.drawCircle(cx, cy, r);
  u8g2.drawDisc(cx - 5, cy - 4, 2);
  u8g2.drawDisc(cx + 5, cy - 4, 2);

  for (int angle = 25; angle <= 155; angle += 5) {
    float rad = angle * PI / 180.0;
    int sx = cx + (int)(cos(rad) * (r - 5));
    int sy = cy + 1 + (int)(sin(rad) * (r - 5));
    u8g2.drawPixel(sx, sy);
    u8g2.drawPixel(sx, sy + 1);
  }
}

